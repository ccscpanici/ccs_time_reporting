[run]
branch = True
source =
    accounts
    jobgrid
    reports
    timesheets

omit =
    */migrations/*
    */tests/*
    manage.py
    */venv/*
    ccs_time_reporting/test_settings.py

[report]
show_missing = True
skip_covered = True
precision = 1

exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    raise NotImplementedError